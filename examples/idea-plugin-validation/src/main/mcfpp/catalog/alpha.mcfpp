namespace validation.alpha

/// Counter from the alpha namespace.
data Counter {
    var value: int = 0
    func increment(amount: int) : int {
        value += amount
        return value
    }
}

data CounterTools {}

/// Convert an integer without changing its type.
func convert(value: int) : int { return value }

/// Convert a string without changing its type.
func convert(value: string) : string { return value }
