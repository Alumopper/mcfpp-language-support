{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcfpp.top/schemas/minecraft/item-modifier.schema.json",
  "title": "Minecraft item modifier",
  "oneOf": [
    { "$ref": "#/$defs/function" },
    { "type": "array", "items": { "$ref": "#/$defs/function" } }
  ],
  "$defs": {
    "function": {
      "type": "object",
      "required": ["function"],
      "properties": {
        "function": {
          "type": "string",
          "enum": [
            "minecraft:apply_bonus", "minecraft:copy_components", "minecraft:copy_custom_data",
            "minecraft:copy_name", "minecraft:copy_state", "minecraft:enchant_randomly",
            "minecraft:enchant_with_levels", "minecraft:exploration_map", "minecraft:explosion_decay",
            "minecraft:fill_player_head", "minecraft:filtered", "minecraft:furnace_smelt",
            "minecraft:limit_count", "minecraft:modify_contents", "minecraft:reference",
            "minecraft:sequence", "minecraft:set_attributes", "minecraft:set_banner_pattern",
            "minecraft:set_components", "minecraft:set_contents", "minecraft:set_count",
            "minecraft:set_custom_data", "minecraft:set_custom_model_data", "minecraft:set_damage",
            "minecraft:set_enchantments", "minecraft:set_firework_explosion", "minecraft:set_fireworks",
            "minecraft:set_instrument", "minecraft:set_item", "minecraft:set_loot_table",
            "minecraft:set_lore", "minecraft:set_name", "minecraft:set_ominous_bottle_amplifier",
            "minecraft:set_potion", "minecraft:set_stew_effect", "minecraft:set_writable_book_pages",
            "minecraft:set_written_book_pages", "minecraft:toggle_tooltips"
          ]
        },
        "conditions": { "type": "array", "items": { "type": "object" } },
        "count": { "oneOf": [{ "type": "number" }, { "type": "object" }] },
        "damage": { "oneOf": [{ "type": "number" }, { "type": "object" }] },
        "add": { "type": "boolean" },
        "item": { "type": "string" },
        "component": { "type": "string" },
        "components": { "type": "object" },
        "name": { "oneOf": [{ "type": "string" }, { "type": "object" }, { "type": "array" }] },
        "entity": { "enum": ["this", "attacker", "direct_attacker", "attacking_player"] },
        "modifier": { "type": "string" },
        "functions": { "type": "array", "items": { "$ref": "#/$defs/function" } }
      },
      "additionalProperties": true
    }
  }
}
