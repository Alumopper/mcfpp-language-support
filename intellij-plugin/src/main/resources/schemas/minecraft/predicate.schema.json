{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcfpp.top/schemas/minecraft/predicate.schema.json",
  "title": "Minecraft predicate",
  "oneOf": [
    { "$ref": "#/$defs/condition" },
    { "type": "array", "items": { "$ref": "#/$defs/condition" } }
  ],
  "$defs": {
    "condition": {
      "type": "object",
      "required": ["condition"],
      "properties": {
        "condition": {
          "type": "string",
          "enum": [
            "minecraft:all_of", "minecraft:any_of", "minecraft:block_state_property",
            "minecraft:damage_source_properties", "minecraft:entity_properties", "minecraft:entity_scores",
            "minecraft:inverted", "minecraft:killed_by_player", "minecraft:location_check",
            "minecraft:match_tool", "minecraft:random_chance", "minecraft:random_chance_with_enchanted_bonus",
            "minecraft:reference", "minecraft:survives_explosion", "minecraft:table_bonus",
            "minecraft:time_check", "minecraft:value_check", "minecraft:weather_check"
          ]
        },
        "terms": { "type": "array", "items": { "$ref": "#/$defs/condition" } },
        "term": { "$ref": "#/$defs/condition" },
        "predicate": { "type": "object" },
        "entity": { "enum": ["this", "attacker", "direct_attacker", "attacking_player"] },
        "chance": { "type": "number", "minimum": 0, "maximum": 1 },
        "name": { "type": "string" },
        "offsetX": { "type": "integer" },
        "offsetY": { "type": "integer" },
        "offsetZ": { "type": "integer" },
        "block": { "type": "string" },
        "properties": { "type": "object" },
        "scores": { "type": "object" },
        "range": { "oneOf": [{ "type": "number" }, { "type": "object" }] },
        "value": {},
        "period": { "type": "integer", "minimum": 1 },
        "raining": { "type": "boolean" },
        "thundering": { "type": "boolean" }
      },
      "additionalProperties": true
    }
  }
}
