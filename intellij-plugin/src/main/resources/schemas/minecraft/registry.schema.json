{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcfpp.top/schemas/minecraft/registry.schema.json",
  "title": "Minecraft data pack registry resource",
  "description": "Permissive base schema for dimension, worldgen, damage type, chat type and other data-driven registries.",
  "type": "object",
  "properties": {
    "type": { "type": "string" },
    "name": { "type": "string" },
    "description": { "oneOf": [{ "type": "string" }, { "type": "object" }, { "type": "array" }] },
    "effects": { "type": "string" },
    "element": { "type": "object" },
    "generator": { "type": "object" },
    "biome": { "type": "string" },
    "biomes": { "oneOf": [{ "type": "string" }, { "type": "array" }, { "type": "object" }] },
    "features": { "type": "array" },
    "placement": { "type": "array" },
    "config": { "type": "object" },
    "settings": { "oneOf": [{ "type": "string" }, { "type": "object" }] },
    "noise": { "oneOf": [{ "type": "string" }, { "type": "object" }] },
    "min_y": { "type": "integer" },
    "height": { "type": "integer", "minimum": 1 },
    "logical_height": { "type": "integer", "minimum": 1 },
    "coordinate_scale": { "type": "number" },
    "ambient_light": { "type": "number", "minimum": 0 },
    "ultrawarm": { "type": "boolean" },
    "natural": { "type": "boolean" },
    "has_skylight": { "type": "boolean" },
    "has_ceiling": { "type": "boolean" },
    "piglin_safe": { "type": "boolean" },
    "bed_works": { "type": "boolean" },
    "respawn_anchor_works": { "type": "boolean" },
    "has_raids": { "type": "boolean" },
    "infiniburn": { "type": "string" },
    "monster_spawn_block_light_limit": { "type": "integer" },
    "monster_spawn_light_level": { "oneOf": [{ "type": "integer" }, { "type": "object" }] },
    "exhaustion": { "type": "number" },
    "message_id": { "type": "string" },
    "scaling": { "enum": ["never", "when_caused_by_living_non_player", "always"] },
    "death_message_type": { "enum": ["default", "fall_variants", "intentional_game_design"] }
  },
  "additionalProperties": true
}
