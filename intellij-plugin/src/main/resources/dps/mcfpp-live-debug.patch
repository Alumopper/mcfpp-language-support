+                    .getAsJsonObject("snapshot")
+                    .getAsJsonObject("scores")
+                    .getAsJsonObject("value")
+                    .get("counter")
+                    .asInt,
+            )
+            debug.dispatch("debug.continue", JsonObject())
+            assertEquals("debug.terminated", events.poll(10, TimeUnit.SECONDS)!!.first)
